{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.gototravelapp.com"
        }
      ],
      "destination": "https://gototravelapp.com/:path*",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://testflight.apple.com/join/HXVp8DH9",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/join/:token",
      "destination": "/api/join?token=:token"
    },
    {
      "source": "/join",
      "destination": "/api/join"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
